---
import { homeRenders } from '../../assets/home/renders';
import { framing } from './framing';
import type { Locale } from '../../i18n/ui';
import video from '../eden-residence-hero-exteriors.mp4?url';
import poster from './opening-poster.jpg?url';
interface Props { locale: Locale }
const { locale } = Astro.props;
---

<!-- The render stays underneath the video, including when autoplay is unavailable. -->
<div class="cinema-window" data-cinema-window style={`--cinema-opening-x: ${framing.opening.horizontalAlignment * 100}%`}>
  <div class="cinema-camera" data-cinema-camera>
    <img src={poster} width="1280" height="720" alt={homeRenders[framing.render].alt[locale]} loading="eager" fetchpriority="high" />
    <video data-cinema-video data-src={video} poster={poster} width="1280" height="720" muted playsinline loop preload="none" disablepictureinpicture disableRemotePlayback aria-hidden="true" tabindex="-1"></video>
  </div>
</div>
