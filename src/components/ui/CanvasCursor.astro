<!-- Opt-in decoration: this component is currently mounted only in the dev hero. -->
<eden-canvas-cursor aria-hidden="true">
  <canvas class="eden-cursor-canvas"></canvas>
</eden-canvas-cursor>

<style>
  eden-canvas-cursor { display: contents; }
  .eden-cursor-canvas {
    /* Screen approximation of RAL 1032 Broom yellow, pending visual approval. */
    --cursor-gold: #e3be61;
    position: fixed; inset: 0; z-index: 100; width: 100%; height: 100%;
    pointer-events: none; opacity: 0; contain: strict;
  }
  .eden-cursor-canvas[data-visible] { opacity: 1; }
  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    .eden-cursor-canvas { display: none; }
  }
</style>

<script>
  import { createCanvasCursor } from '../../lib/cursor/canvas-cursor';

  class EdenCanvasCursor extends HTMLElement {
    private dispose?: () => void;
    static observedAttributes = ['disabled'];

    connectedCallback() {
      if (this.dispose || this.hasAttribute('disabled')) return;
      const canvas = this.querySelector('canvas');
      if (canvas) this.dispose = createCanvasCursor(canvas);
    }

    disconnectedCallback() { this.dispose?.(); this.dispose = undefined; }
    attributeChangedCallback() {
      this.disconnectedCallback();
      if (this.isConnected) this.connectedCallback();
    }
  }

  if (!customElements.get('eden-canvas-cursor')) customElements.define('eden-canvas-cursor', EdenCanvasCursor);
</script>
