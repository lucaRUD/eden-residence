---
import type { Locale } from '../../i18n/ui';
import { themeCopy } from '../../i18n/theme';

interface Props { locale: Locale; appearance?: 'default' | 'icon' }
const { locale, appearance = 'default' } = Astro.props;
const copy = themeCopy[locale];
---

<button type="button" data-theme-toggle data-theme-action={appearance === 'icon' ? '' : undefined} data-light-label={copy.switchToLight} data-dark-label={copy.switchToDark} class={appearance === 'icon' ? 'theme-icon-toggle' : 'button button--outline button--sm'} aria-label={copy.dark} aria-pressed={appearance === 'icon' ? undefined : 'false'} title={copy.dark} hidden>
  {appearance === 'icon' ? <>
    <svg data-theme-icon="moon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.5 14.1A8.7 8.7 0 0 1 9.9 3.5a8.7 8.7 0 1 0 10.6 10.6Z" /></svg>
    <svg data-theme-icon="sun" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
  </> : <>
    <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="10" r="7" /><path d="M10 3a7 7 0 0 1 0 14Z" fill="currentColor" stroke="none" /></svg>
    <span>{copy.label}</span>
  </>}
</button>

<style>
  .theme-icon-toggle { display: inline-flex; align-items: center; justify-content: center; min-width: var(--spacing-control); min-height: var(--spacing-control); border-radius: 50%; color: var(--section-heading); cursor: pointer; }
  .theme-icon-toggle:hover { background: var(--theme-secondary); }
  [data-theme-icon='sun'] { display: none; }
  :global([data-theme='dark']) [data-theme-icon='sun'] { display: block; }
  :global([data-theme='dark']) [data-theme-icon='moon'] { display: none; }
</style>

<script>
  import '../../lib/theme';
</script>
