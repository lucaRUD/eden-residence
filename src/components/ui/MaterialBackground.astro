---
import type { MaterialBackgroundSettings } from '../../assets/home/materials';

interface Props {
  settings: MaterialBackgroundSettings;
  variant: 'project' | 'interiors';
}
const { settings, variant } = Astro.props;
const style = [
  `--material-image: url("${settings.src}")`,
  `--material-opacity: ${settings.opacity}`,
  `--material-desktop-travel: ${Math.max(0, settings.travel)}px`,
  `--material-mobile-travel: ${Math.max(0, settings.mobileTravel)}px`,
  `--material-desktop-position: ${settings.position}`,
  `--material-mobile-position: ${settings.mobilePosition}`,
].join(';');
---

{settings.enabled && (
  <div class:list={['material-background', `material-background--${variant}`]} data-material-background={variant} style={style} aria-hidden="true">
    <div class="material-background__surface" data-material-surface></div>
  </div>
)}

<style>
  /* Local stacking only: no layout, photography or pin measurements change. */
  :global(.home-project__title:has(> .material-background)) { position: relative; isolation: isolate; }
  :global(.interior-gallery__stage:has(> .material-background)) { isolation: isolate; }
  .material-background {
    --material-travel: var(--material-desktop-travel);
    --material-position: var(--material-desktop-position);
    position: absolute; z-index: -1; inset: 0; overflow: clip;
    opacity: var(--material-opacity); pointer-events: none; user-select: none;
  }
  .material-background__surface {
    position: absolute; inset: calc(var(--material-travel) / -2 - 2px) 0;
    background-image: var(--material-image); background-size: cover;
    background-position: var(--material-position); background-repeat: no-repeat;
  }
  .material-background[data-material-active] .material-background__surface { will-change: transform; }
  .material-background--project {
    inset: -.6rem auto -.6rem calc(var(--spacing-gutter) * -1);
    width: min(36vw, calc(100% + var(--spacing-gutter)));
    mask-image: linear-gradient(90deg, transparent, #000 12% 60%, transparent),
      linear-gradient(180deg, transparent, #000 15% 85%, transparent);
    mask-composite: intersect;
  }
  @media (max-width: 63.999rem) {
    .material-background {
      --material-travel: var(--material-mobile-travel);
      --material-position: var(--material-mobile-position);
    }
    .material-background--project { width: 70%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .material-background__surface { transform: none !important; will-change: auto !important; }
  }
  @media (forced-colors: active) {
    .material-background { display: none; }
  }
</style>

<script>
  import { mountMaterialBackgrounds, unmountMaterialBackgrounds } from '../../lib/motion/material-background';
  mountMaterialBackgrounds();
  document.addEventListener('astro:page-load', mountMaterialBackgrounds);
  document.addEventListener('astro:before-swap', unmountMaterialBackgrounds);
  window.addEventListener('pagehide', event => { if (!event.persisted) unmountMaterialBackgrounds(); });
  window.addEventListener('pageshow', mountMaterialBackgrounds);
</script>
