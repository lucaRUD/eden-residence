---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  aspectRatio?: number | string;
  borderRadius?: string;
  parallaxIntensity?: number;
  position?: string;
  fill?: boolean;
  priority?: boolean;
  renderName?: string;
  class?: string;
}

const {
  src, alt, sizes, aspectRatio = src.width / src.height,
  borderRadius = 'var(--radius-image)', parallaxIntensity = 1,
  position = 'right bottom',
  fill = false, priority = false, renderName, class: className,
} = Astro.props;
const intensity = (value: number) => Number.isFinite(value) ? Math.min(1.25, Math.max(0, value)) : 1;
const widths = [480, 768, 1120, src.width].filter(width => width <= src.width);
const style = [
  `--depth-ratio: ${aspectRatio}`,
  `--depth-radius: ${borderRadius}`,
  `--depth-position: ${position}`,
].join(';');
---

<div class:list={['scroll-depth-image', className]} data-scroll-depth data-depth-fill={fill || undefined} data-depth-parallax={intensity(parallaxIntensity)} style={style}>
  <div class="scroll-depth-image__frame" data-depth-frame>
    <!-- Existing chapter wipes own this clip; depth never transforms it. -->
    <div class="home-render scroll-depth-image__clip" data-render={renderName}>
      <div class="scroll-depth-image__inner" data-depth-inner>
        <Image src={src} alt={alt} widths={widths} sizes={sizes} format="webp" quality={85} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
      </div>
    </div>
  </div>
</div>

<style>
  .scroll-depth-image { position: relative; width: 100%; min-width: 0; aspect-ratio: var(--depth-ratio); }
  .scroll-depth-image__frame { position: absolute; inset: 0; overflow: hidden; border-radius: var(--depth-radius); }
  .scroll-depth-image .scroll-depth-image__clip { position: absolute; inset: 0; width: 100%; height: 100%; min-height: 0; overflow: hidden; border-radius: inherit; }
  .scroll-depth-image__inner { position: absolute; left: 0; right: 0; top: calc((100% - var(--depth-content-height, 100%)) / 2); height: var(--depth-content-height, 100%); }
  .scroll-depth-image .scroll-depth-image__inner > img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; object-position: var(--depth-position); }
  .scroll-depth-image[data-depth-fill] { height: 100%; min-height: 15rem; aspect-ratio: auto; overflow: clip; }
  .scroll-depth-image[data-depth-active] .scroll-depth-image__inner { will-change: transform; }
  @media (prefers-reduced-motion: reduce) {
    .scroll-depth-image__inner { top: 0 !important; height: 100% !important; transform: none !important; will-change: auto !important; }
  }
</style>
