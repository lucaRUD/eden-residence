---
import Container from '../ui/Container.astro';
import ScrollDepthImage from '../ui/ScrollDepthImage.astro';
import { homeRenders } from '../../assets/home/renders';
import type { HomeCopy } from '../../i18n/home';
import type { Locale } from '../../i18n/ui';
interface Props { copy: HomeCopy['gardens']; locale: Locale }
const { copy, locale } = Astro.props;
---

<section id="gardens" class="home-gardens home-chapter" aria-labelledby="gardens-heading">
  <Container width="wide" class="home-gardens__heading">
    <p class="eyebrow" data-journey-anchor>{copy.eyebrow}</p>
    <h2 id="gardens-heading" class="home-display">{copy.title}</h2>
  </Container>
  <Container width="wide" class="home-gardens__composition">
    <figure class="home-gardens__primary">
      <ScrollDepthImage src={homeRenders.garden.image} alt={homeRenders.garden.alt[locale]} renderName="garden" sizes="(min-width: 1440px) 880px, (min-width: 768px) 62vw, 92vw" />
      <figcaption class="home-caption">{copy.primaryCaption}</figcaption>
    </figure>
    <div class="home-gardens__aside">
      <div class="home-gardens__copy">
        <p class="text-lead text-heading">{copy.description}</p>
        <p class="mt-4 text-body text-muted">{copy.detail}</p>
      </div>
      <div class="home-gardens__secondary">
        <figure>
          <ScrollDepthImage src={homeRenders.walkway.image} alt={homeRenders.walkway.alt[locale]} renderName="walkway" sizes="(min-width: 1440px) 420px, (min-width: 768px) 30vw, 82vw" />
          <figcaption class="home-caption">{copy.secondaryCaption}</figcaption>
        </figure>
      </div>
    </div>
  </Container>
</section>
