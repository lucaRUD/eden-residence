---
import type { Locale } from '../../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
---

<div data-home-preloader role="status" aria-live="polite" aria-atomic="true">
  <svg viewBox="250 480 1064 565" width="240" height="128" role="img" aria-label="Eden Residence">
    <image href="/brand/logo-Eden-residence-cream-nobg.png" width="1563" height="1563" />
  </svg>
  <p>{locale === 'ro' ? 'PREGĂTIM EXPERIENȚA' : 'PREPARING YOUR EXPERIENCE'}</p>
  <span class="home-preloader__line" aria-hidden="true"></span>
</div>
