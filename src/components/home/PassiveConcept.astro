---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import { passiveStoryImages } from '../../assets/home/passive-story';
import { passiveStoryCopy } from '../../i18n/passive-story';
import type { HomeCopy } from '../../i18n/home';
import type { Locale } from '../../i18n/ui';
import '../../styles/passive-editorial.css';
interface Props { copy: HomeCopy['passive']; locale: Locale }
const { locale } = Astro.props;
const copy = passiveStoryCopy[locale];
const photographs = [passiveStoryImages.architecture, passiveStoryImages.reveal];
---

<section id="passive-concept" class="passive-editorial" data-passive-editorial aria-labelledby="passive-heading">
  <!-- This static document milestone stays outside the pinned camera stage. -->
  <span class="passive-editorial__anchor" data-journey-anchor aria-hidden="true"></span>
  <div class="passive-editorial__viewport" data-ps-viewport aria-hidden="true"></div>
  <div class="passive-editorial__stage" data-ps-stage>
    <p class="eyebrow passive-editorial__eyebrow">{copy.eyebrow}</p>
    <div class="passive-editorial__opening" data-ps-opening>
      <h2 id="passive-heading" aria-label={copy.opening.text}>
        {copy.opening.lines.map(line => <span class="passive-editorial__mask" aria-hidden="true"><span data-ps-opening-track>{line}</span></span>)}
      </h2>
      <p class="passive-editorial__intro" data-ps-intro>{copy.intro}</p>
    </div>
    <div class="passive-editorial__architecture" data-ps-architecture-heading>
      <h3 aria-label={copy.architecture.text}>
        {copy.architecture.lines.map(line => <span class="passive-editorial__mask" aria-hidden="true"><span data-ps-architecture-track>{line}</span></span>)}
      </h3>
    </div>
    <div class="passive-editorial__photo" data-ps-photo="architecture" style={`--ps-position:${photographs[0].position};--ps-portrait-position:${photographs[0].portraitPosition}`}>
      <div class="passive-editorial__photo-position" data-ps-photo-position>
        <div class="passive-editorial__photo-inner" data-ps-photo-inner>
          <Image src={photographs[0].image} alt={photographs[0].alt[locale]} widths={[480, 768, 1120, photographs[0].image.width]} sizes="(max-aspect-ratio: 16/9) 178svh, 100vw" format="webp" quality={85} loading="lazy" decoding="async" draggable="false" />
        </div>
      </div>
    </div>
    <div class="passive-editorial__canopy" data-ps-canopy aria-hidden="true" style={`--ps-canopy-image:url("${passiveStoryImages.canopy.image.src}");--ps-canopy-mask:url("${passiveStoryImages.canopy.mask.src}")`}></div>
    <div class="passive-editorial__principles-heading" data-ps-principles-heading>
      <h3 aria-label={copy.principlesHeading.text}>
        {copy.principlesHeading.lines.map(line => <span class="passive-editorial__mask" aria-hidden="true"><span data-ps-principles-track>{line}</span></span>)}
      </h3>
    </div>
    <div class="passive-editorial__principles" data-ps-principles>
      <svg class="passive-editorial__route" data-ps-svg aria-hidden="true" focusable="false">
        <path class="passive-editorial__route-base" data-ps-route-base></path>
        <path class="passive-editorial__route-draw" data-ps-route></path>
        {copy.principles.map(() => <circle r="4" data-ps-route-node></circle>)}
      </svg>
      <ol id="passive-principles" tabindex="-1">
        {copy.principles.map((principle, index) => (
          <li data-ps-principle>
            <span class="passive-editorial__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h4>{principle.label}</h4>
            <p class="passive-editorial__principle-description">{principle.description}</p>
          </li>
        ))}
      </ol>
      <div class="passive-editorial__notes" aria-hidden="true">
        {copy.principles.map(principle => <p data-ps-note>{principle.description}</p>)}
      </div>
    </div>
    <div class="passive-editorial__photo passive-editorial__photo--reveal" data-ps-photo="reveal" style={`--ps-position:${photographs[1].position};--ps-portrait-position:${photographs[1].portraitPosition}`}>
      <div class="passive-editorial__photo-position" data-ps-photo-position>
        <div class="passive-editorial__photo-inner" data-ps-photo-inner>
          <Image src={photographs[1].image} alt={photographs[1].alt[locale]} widths={[480, 768, 1120, photographs[1].image.width]} sizes="(max-aspect-ratio: 1475/1067) 139svh, 100vw" format="webp" quality={85} loading="lazy" decoding="async" draggable="false" />
        </div>
      </div>
      <div class="passive-editorial__photo-shade" aria-hidden="true"></div>
    </div>
    <div class="passive-editorial__closing" data-ps-closing>
      <h3 aria-label={copy.closing.text}>
        {copy.closing.lines.map(line => <span class="passive-editorial__mask" aria-hidden="true"><span data-ps-closing-track>{line}</span></span>)}
      </h3>
      <Button href={copy.action.href} size="lg">{copy.action.label}<span aria-hidden="true">↗</span></Button>
    </div>
  </div>
</section>

<script>
  import { mountPassiveEditorial, unmountPassiveEditorial } from '../../lib/motion/passive-editorial';
  mountPassiveEditorial();
  document.addEventListener('astro:page-load', mountPassiveEditorial);
  document.addEventListener('astro:before-swap', unmountPassiveEditorial);
  window.addEventListener('pagehide', event => { if (!event.persisted) unmountPassiveEditorial(); });
  window.addEventListener('pageshow', mountPassiveEditorial);
</script>
