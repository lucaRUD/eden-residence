---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import ScrollDepthImage from '../ui/ScrollDepthImage.astro';
import { homeRenders } from '../../assets/home/renders';
import type { HomeCopy } from '../../i18n/home';
import type { Locale } from '../../i18n/ui';
interface Props { copy: HomeCopy['passive']; locale: Locale }
const { copy, locale } = Astro.props;
---

<Section id="passive-concept" width="wide" tone="brand" class="home-passive" aria-labelledby="passive-heading">
  <div class="home-passive__heading">
    <p class="eyebrow" data-journey-anchor>{copy.eyebrow}</p>
    <div class="home-passive__statement" data-content-status="provisional">
      <p class="home-passive__status text-small">{copy.provisionalLabel}</p>
      <h2 id="passive-heading" class="home-display" aria-describedby="passive-qualification">{copy.title}</h2>
    </div>
    <div class="home-passive__context">
      <p class="home-passive__description text-lead">{copy.description}</p>
      <p id="passive-qualification" class="home-passive__qualification text-small text-muted">{copy.qualification}</p>
      <div class="home-passive__action">
        <Button href={copy.actionHref}>{copy.action}<span aria-hidden="true">↗</span></Button>
        <p class="mt-3 text-small text-muted">{copy.pageStatus}</p>
      </div>
    </div>
  </div>
  <div class="home-passive__body">
    <figure class="home-passive__image">
      <ScrollDepthImage src={homeRenders.passive.image} alt={homeRenders.passive.alt[locale]} renderName="passive" sizes="(min-width: 1440px) 820px, (min-width: 1024px) 60vw, 92vw" />
      <figcaption class="home-caption">{copy.imageCaption}</figcaption>
    </figure>
    <div class="home-passive__reading">
      <dl id="passive-principles" class="home-principles" tabindex="-1">
        {copy.principles.map((principle, index) => (
          <div class="home-principle">
            <dt class="home-principle__title"><span aria-hidden="true">0{index + 1}</span>{principle.title}</dt>
            <dd class="text-body text-muted">{principle.description}</dd>
          </div>
        ))}
      </dl>
      <p class="home-passive__note text-body text-muted">{copy.note}</p>
    </div>
  </div>
</Section>
