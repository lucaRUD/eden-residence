---
import Section from '../ui/Section.astro';
import type { HomeCopy } from '../../i18n/home';
interface Props { copy: HomeCopy['vision'] }
const { copy } = Astro.props;
---

<Section id="vision" width="wide" tone="surface" class="home-vision" aria-labelledby="vision-heading">
  <div class="home-vision__heading">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="vision-heading" class="home-statement">{copy.title}</h2>
  </div>
  <ol class="home-benefits">
    {copy.features.map((feature, index) => (
      <li class="home-benefit">
        <span class="home-benefit__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <h3>{feature.title}</h3>
        <p class="text-body text-muted">{feature.description}</p>
      </li>
    ))}
  </ol>
</Section>
