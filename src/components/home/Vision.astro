---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { HomeCopy } from '../../i18n/home';
interface Props { copy: HomeCopy['vision'] }
const { copy } = Astro.props;
---

<Section id="vision" width="wide" tone="surface" aria-labelledby="vision-heading">
  <SectionHeading id="vision-heading" eyebrow={copy.eyebrow} title={copy.title} />
  <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
    {copy.features.map((feature, index) => (
      <li class="border-t border-divider pt-6">
        <p class="text-label text-accent" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
        <h3 class="mt-6 text-h4 text-heading">{feature.title}</h3>
        <p class="mt-4 max-w-reading text-body text-muted">{feature.description}</p>
      </li>
    ))}
  </ol>
</Section>
