---
import Section from '../ui/Section.astro';
import RenderImage from './RenderImage.astro';
import type { HomeCopy } from '../../i18n/home';
import type { Locale } from '../../i18n/ui';
interface Props { copy: HomeCopy['apartments']; locale: Locale }
const { copy, locale } = Astro.props;
---

<Section id="apartments" width="wide" tone="contrast" class="home-apartment-section" aria-labelledby="apartments-heading">
  <div class="home-apartments__heading">
    <div>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 id="apartments-heading" class="home-display">{copy.title}</h2>
    </div>
    <p class="text-body text-muted">{copy.description}</p>
  </div>
  <p id="apartment-imagery-note" class="home-apartments__imagery-note text-small text-muted">{copy.imageNote}</p>
  <div class="home-apartments">
    {copy.categories.map((category, index) => (
      <article id={category.id} class:list={['home-apartment', { 'section--brand': index === 1 }]} aria-labelledby={`${category.id}-heading`}>
        <a href="#contact-information" class="home-apartment__link" aria-labelledby={`${category.id}-heading`} aria-describedby={`apartment-imagery-note ${category.id}-action`}>
          <div class="home-apartment__visual">
            <RenderImage name={index === 0 ? 'apartmentTwo' : 'apartmentThree'} locale={locale} sizes="(min-width: 1440px) 644px, (min-width: 768px) 46vw, 92vw" />
          </div>
          <div class="home-apartment__content">
            <div class="home-apartment__identity">
              <div class="home-apartment__count" aria-hidden="true">
                <span class="home-apartment__number">{category.rooms}</span>
                <span class="eyebrow">{category.label}</span>
              </div>
              <h3 id={`${category.id}-heading`} class="home-apartment__title">{category.title}</h3>
            </div>
            <p class="text-body text-muted">{category.description}</p>
            <span id={`${category.id}-action`} class="home-apartment__action">{category.action}<span class="home-apartment__arrow" aria-hidden="true">↗</span></span>
          </div>
        </a>
      </article>
    ))}
  </div>
  <p class="mt-8 max-w-reading text-body text-muted">{copy.note}</p>
</Section>
