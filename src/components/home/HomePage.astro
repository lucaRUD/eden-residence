---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import Footer from '../layout/Footer.astro';
import Hero from './Hero.astro';
import ProjectIntro from './ProjectIntro.astro';
import Vision from './Vision.astro';
import GreenLiving from './GreenLiving.astro';
import ApartmentTypes from './ApartmentTypes.astro';
import PassiveConcept from './PassiveConcept.astro';
import ContactCTA from './ContactCTA.astro';
import { homeCopy } from '../../i18n/home';
import { homePaths, type Locale } from '../../i18n/ui';
import '../../styles/home.css';
interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = homeCopy[locale];
---

<BaseLayout locale={locale} title={copy.meta.title} description={copy.meta.description}>
  <Header locale={locale} items={copy.navigation} homeHref={homePaths[locale]} />
  <main id="main-content" tabindex="-1">
    <Hero locale={locale} copy={copy.hero} />
    <ProjectIntro locale={locale} copy={copy.project} />
    <Vision copy={copy.vision} />
    <GreenLiving locale={locale} copy={copy.gardens} />
    <ApartmentTypes copy={copy.apartments} />
    <PassiveConcept locale={locale} copy={copy.passive} />
    <ContactCTA copy={copy.contact} />
  </main>
  <Footer locale={locale} items={copy.navigation} homeHref={homePaths[locale]} note={copy.footerNote} />
</BaseLayout>
