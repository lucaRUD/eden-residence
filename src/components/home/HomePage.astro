---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FloatingNavigation from '../layout/FloatingNavigation.astro';
import Footer from '../layout/Footer.astro';
import ArchitecturalHero from './ArchitecturalHero.astro';
import EditorialIntroduction from './EditorialIntroduction.astro';
import CanvasCursor from '../ui/CanvasCursor.astro';
import ProjectIntro from './ProjectIntro.astro';
import GreenLiving from './GreenLiving.astro';
import ApartmentTypes from './ApartmentTypes.astro';
import PassiveConcept from './PassiveConcept.astro';
import ContactCTA from './ContactCTA.astro';
import EdenJourney from './EdenJourney.astro';
import { homeCopy } from '../../i18n/home';
import { homePaths, type Locale } from '../../i18n/ui';
import '../../styles/home.css';
interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = homeCopy[locale];
const languages = [
  { locale: 'ro' as const, label: 'Română', href: homePaths.ro },
  { locale: 'en' as const, label: 'English', href: homePaths.en },
];
---

<BaseLayout locale={locale} title={copy.meta.title} description={copy.meta.description}>
  <FloatingNavigation locale={locale} items={copy.navigation} homeHref={homePaths[locale]} languageLinks={languages} contactAction={copy.navigation.find(item => item.href === '#contact')} />
  <main id="main-content" class="home-page home-page--cinematic" data-home-motion data-story-root tabindex="-1">
    <ArchitecturalHero locale={locale} />
    <EditorialIntroduction locale={locale} copy={copy.introduction} heroCopy={copy.hero} />
    <PassiveConcept locale={locale} copy={copy.passive} />
    <ProjectIntro locale={locale} copy={copy.project} />
    <ApartmentTypes locale={locale} copy={copy.apartments} />
    <GreenLiving locale={locale} copy={copy.gardens} />
    <ContactCTA locale={locale} copy={copy.contact} />
    <EdenJourney />
  </main>
  <Footer locale={locale} items={copy.navigation} homeHref={homePaths[locale]} note={copy.footerNote} />
  <CanvasCursor />
</BaseLayout>

<script>
  import { mountHomeMotion, unmountHomeMotion } from '../../lib/motion/home';

  mountHomeMotion();
  document.addEventListener('astro:page-load', mountHomeMotion);
  document.addEventListener('astro:before-swap', unmountHomeMotion);
  // A cached document retains its pin spacing and scroll position while frozen.
  window.addEventListener('pagehide', event => { if (!event.persisted) unmountHomeMotion(); });
  window.addEventListener('pageshow', mountHomeMotion);
</script>
