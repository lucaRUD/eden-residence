---
import Button from '../ui/Button.astro';
import RenderImage from './RenderImage.astro';
import type { HomeCopy } from '../../i18n/home';
import type { Locale } from '../../i18n/ui';
interface Props { copy: HomeCopy['hero']; locale: Locale }
const { copy, locale } = Astro.props;
---

<section aria-labelledby="home-heading" class="home-hero">
  <div class="home-hero__stage">
    <div class="home-hero__visual">
      <RenderImage name="hero" mobileName="heroMobile" locale={locale} priority sizes="100vw" />
    </div>
    <div class="home-hero__panel">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1 id="home-heading" class="home-hero__heading">{copy.title}</h1>
      <p class="home-hero__description text-body">{copy.description}</p>
      <div class="home-hero__actions">
        <Button href="#project">{copy.primaryAction}<span aria-hidden="true">↗</span></Button>
        <a href="#apartments" class="home-text-link">{copy.secondaryAction}<span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </div>
</section>
