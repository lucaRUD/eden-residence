---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import RenderImage from './RenderImage.astro';
import type { HomeCopy } from '../../i18n/home';
import type { Locale } from '../../i18n/ui';
interface Props { copy: HomeCopy['project']; locale: Locale }
const { copy, locale } = Astro.props;
---

<Section id="project" width="wide" aria-labelledby="project-heading">
  <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
    <figure class="min-w-0 lg:col-span-7">
      <RenderImage name="project" locale={locale} sizes="(min-width: 1440px) 730px, (min-width: 1024px) 54vw, 92vw" />
      <figcaption class="home-caption">{copy.imageCaption}</figcaption>
    </figure>
    <div class="lg:col-span-5">
      <SectionHeading id="project-heading" eyebrow={copy.eyebrow} title={copy.title} />
      <p class="mt-6 text-lead text-heading">{copy.description}</p>
      <p class="mt-6 text-body text-muted">{copy.body}</p>
      <a href="#vision" class="home-text-link mt-6">{copy.action}<span aria-hidden="true">↗</span></a>
    </div>
  </div>
</Section>
