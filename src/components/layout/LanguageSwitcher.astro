---
import { homePaths, ui, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const languages = [
  { locale: 'ro', label: 'Română' },
  { locale: 'en', label: 'English' },
] as const;
---

<nav aria-label={ui[locale].languageNavigation}>
  <ul class="flex flex-wrap gap-2">
    {languages.map((language) => (
      <li>
        <a
          href={homePaths[language.locale]}
          lang={language.locale}
          hreflang={language.locale}
          aria-current={locale === language.locale ? 'page' : undefined}
          class:list={[
            'inline-flex min-h-11 items-center rounded-sm px-3 py-2 text-sm underline-offset-4 hover:underline',
            locale === language.locale ? 'bg-brand-green text-brand-cream' : 'text-brand-green',
          ]}
        >
          {language.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
