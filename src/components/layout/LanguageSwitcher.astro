---
import { homePaths, ui, type Locale } from '../../i18n/ui';
import type { LanguageLink } from '../../lib/navigation';

interface Props {
  locale: Locale;
  links?: readonly LanguageLink[];
}

const { locale, links = [
  { locale: 'ro', label: 'Română', href: homePaths.ro },
  { locale: 'en', label: 'English', href: homePaths.en },
] } = Astro.props;
---

<nav aria-label={ui[locale].languageNavigation}>
  <ul class="flex flex-wrap gap-2">
    {links.map((language) => (
      <li>
        <a
          href={language.href}
          lang={language.locale}
          hreflang={language.locale}
          aria-current={locale === language.locale ? 'page' : undefined}
          class:list={[
            'inline-flex min-h-control items-center rounded-control px-3 py-2 text-navigation font-control underline-offset-4 hover:underline',
            locale === language.locale ? 'bg-action text-action-ink' : 'text-heading',
          ]}
        >
          {language.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
