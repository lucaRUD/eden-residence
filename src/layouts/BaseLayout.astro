---
import '@fontsource-variable/quicksand';
import '../styles/global.css';
import { ui, type Locale } from '../i18n/ui';
import themeInit from '../lib/theme-init.js?raw';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={themeInit} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Local review only; remove after production content and SEO approval. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-background font-sans text-ink antialiased">
    <a class="skip-link" href="#main-content">{ui[locale].skipLink}</a>
    <slot />
  </body>
</html>
